# Copie para .env e preencha. Nunca commite o .env.

# Evolution API
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
EVOLUTION_URL=http://IP_DO_SERVIDOR:8080
EVOLUTION_API_KEY=troque-por-uma-chave-longa-e-aleatoria
EVOLUTION_INSTANCE=agrozap-demo

# Postgres (usado pela Evolution e pela aplicação)
POSTGRES_USER=agrozap
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://agrozap:troque-esta-senha@IP_DO_SERVIDOR:5432/agrozap

# Bot do Núcleo (bot/). A Evolution (no Docker) chama http://host.docker.internal:BOT_PORT/webhook/<sufixo>
BOT_PORT=3000
# Agrupamento de mensagens por número (debounce em memória): janela reiniciada a cada mensagem nova e máximo desde a primeira. 0 desliga.
DEBOUNCE_MS=2500
DEBOUNCE_MAX_MS=12000
# Modo teste: se preenchido (números separados por vírgula, só dígitos), o bot só responde a eles.
# DEIXAR VAZIO na demo e no MVP funcional.
BOT_SOMENTE_NUMEROS=
BOT_WEBHOOK_URL=http://localhost:3000/webhook/agro-zap-TROQUE-POR-SUFIXO-ALEATORIO

# Chat (conversa, extração da safra, redator tributário) — qualquer API compatível com OpenAI.
# PROVISÓRIO: hoje é o Gemini; depois vai para a OpenAI. A troca é só mudar estas 3 variáveis
# e rodar os roteiros A a D de novo. Nada no fluxo é específico de um provedor.
# Gemini (atual):  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OpenAI (depois): LLM_BASE_URL=https://api.openai.com/v1
# Ollama (fallback): LLM_BASE_URL=http://IP_DO_OLLAMA:11434/v1   (LLM_API_KEY=ollama)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Nome do modelo conforme a doc do provedor (confirmar o vigente antes de usar)
LLM_MODEL_CHAT=gemini-3.1-flash-lite

# Áudio (transcrição e voz da IAra) — OpenAI, separado do chat (Etapa 5 do PLAN).
# AUDIO_ATIVO=true liga tudo (precisa de AUDIO_API_KEY); false desliga: áudio recebido volta a responder AUDIO_AINDA_NAO e BOAS_VINDAS/MENU deixam de oferecer áudio. Reinicie o bot ao mudar.
# Transcrição: POST {AUDIO_BASE_URL}/audio/transcriptions · Voz: POST {AUDIO_BASE_URL}/audio/speech
AUDIO_ATIVO=false
AUDIO_BASE_URL=https://api.openai.com/v1
AUDIO_API_KEY=
AUDIO_MODEL_TRANSCRICAO=whisper-1
AUDIO_MODEL_TTS=gpt-4o-mini-tts
TTS_VOZ=
TTS_FORMATO=mp3

# Gatilho de preço real (Plus 2; só quando for implementada)
N8N_GATILHOS_WEBHOOK_URL=http://IP_DO_N8N:5678/webhook/agro-zap-gatilhos
N8N_GATILHOS_SEGREDO=troque-por-um-segredo-longo

# Webapp
WEB_URL=http://IP_DO_SERVIDOR:3001
ADMIN_SENHA=troque-esta-senha-do-admin

# Demo
DEMO_NUMERO_WHATSAPP=55DDDNUMERO

# Preços e clima (consultas reais sem chave, timeout de 5 s; falha responde "Não consegui consultar agora"). Reinicie o bot ao mudar.
# PRECOS_ATIVO: dólar (AwesomeAPI) + cotações ilustrativas de soja, milho, trigo e boi gordo (bot/cotacoes-demo.js; não alimentam o alerta de preço)
# CLIMA_ATIVO: tempo dos próximos 5 dias por cidade (Open-Meteo)
PRECOS_ATIVO=true
CLIMA_ATIVO=true
